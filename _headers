# Caching-Regeln für Cloudflare Pages.
# Schriften, Bilder und QR-Codes tragen keinen Versionsstempel im Namen, werden
# aber praktisch nie geändert — ein Jahr Cache ist hier richtig. Die Seite
# selbst und die Speisekarten-Daten müssen dagegen sofort aktuell sein, sonst
# sehen Gäste nach einer Preisänderung tagelang alte Preise.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/qr/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

/assets/data/*
  Cache-Control: public, max-age=300

/
  Cache-Control: public, max-age=300
