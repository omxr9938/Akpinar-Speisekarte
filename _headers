# Caching-Regeln für Cloudflare Pages.
#
# CSS, JavaScript und die Speisekarten-Daten tragen über tools/stamp-assets.py
# eine Versionskennung aus dem Dateiinhalt in der Adresse (?v=…). Ändert sich
# der Inhalt, ändert sich die Adresse — die alte Fassung wird nie wieder
# angefragt. Deshalb dürfen sie lange gespeichert bleiben.
#
# index.html trägt keine Kennung und verweist auf die aktuellen Versionen.
# Diese Datei darf nie zwischengespeichert werden, sonst kommen Korrekturen
# erst Stunden später bei den Gästen an.

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/data/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/qr/*
  Cache-Control: public, max-age=31536000, immutable
